<div
  data-id="event_preview"
  data-layout="list"
  class="flex gap-4 px-4 py-3.5 rounded-box border border-divider bg-surface hover:bg-fill transition-colors"
>
  <div class="flex-1 min-w-0 flex flex-col gap-1">
    {#case EventLive.starts(@object)}
      {#match nil}
      {#match start}
        <div class="flex items-center gap-2 type-caption text-muted">
          <span
            :if={happening_now?(@object)}
            data-role="event_now"
            class="badge badge-sm badge-error badge-soft gap-1 font-medium"
          >
            <span class="size-1.5 rounded-full bg-current" aria-hidden="true" />
            {l("Now")}
          </span>
          <time data-role="event_time" datetime={start.iso}>
            {#if @date_in_heading}
              {DatesTimes.format_time_range(start, EventLive.ends(@object)) || l("All day")}
            {#else}
              {DatesTimes.format_range(start, EventLive.ends(@object))}
            {/if}
          </time>
        </div>
    {/case}

    <LinkLive to={@permalink || path(@object)}>
      <h2 class="text-base font-bold text-base-content text-balance leading-snug line-clamp-2 hover:underline">
        {EventLive.name(@object) || l("Untitled event")}
      </h2>
    </LinkLive>

    {#case host_name(@object, @activity)}
      {#match nil}
      {#match host}
        <p data-role="event_host" class="type-meta text-muted truncate">
          {l("By %{name}", name: host)}
        </p>
    {/case}

    {!-- div, not p: the icon is a block --}
    <div
      :if={EventLive.place(@object) || EventLive.online_address(@object)}
      data-role="event_where"
      class="flex items-center gap-1.5 type-meta text-muted min-w-0"
    >
      <#Icon iconify="ph:map-pin" class="size-4 shrink-0" />
      {#if EventLive.place(@object)}
        {#case EventLive.place_link(EventLive.place(@object))}
          {#match nil}
            <span data-role="event_place" class="truncate">{EventLive.place(@object)}</span>
          {#match url}
            <a
              data-role="event_place"
              href={url}
              target="_blank"
              rel="noopener nofollow"
              class="truncate hover:underline"
            >{EventLive.place(@object)}</a>
        {/case}
      {/if}
      <a
        :if={EventLive.online_address(@object)}
        data-role="event_online"
        href={EventLive.online_address(@object)}
        target="_blank"
        rel="noopener nofollow"
        class="shrink-0 hover:underline"
      >{l("Online")}</a>
    </div>

    <div
      :if={badge_names(@object, @exclude_category_id) != [] or origin(@object)}
      class="flex flex-wrap items-center gap-1.5 mt-1"
    >
      {#for topic <- badge_names(@object, @exclude_category_id)}
        <span
          data-role="event_badge"
          class="badge badge-sm gap-1 border-0 bg-fill-strong text-base-content"
        >
          <Iconify.iconify :if={topic.icon} icon={topic.icon} class="size-3" />
          {topic.name}
        </span>
      {/for}

      <span :if={origin(@object)} data-role="event_origin" class="type-caption text-muted">
        {l("from %{server}", server: origin(@object))}
      </span>
    </div>
  </div>

  {#case Bonfire.Common.Media.media_url(cover(@primary_image, @object))}
    {#match nil}
      {!-- with no image: a square in the colour (and icon) of its main topic when it has one, as the card's and the tile's placeholder; nothing otherwise --}
      {#case EventCoverLive.main_topic(@object, @exclude_category_id)}
        {#match %{colour: colour} = topic when not is_nil(colour)}
          <div
            data-role="event_placeholder"
            class={[
              "size-24 shrink-0 rounded-box flex items-center justify-center topic-wash",
              Bonfire.Common.Swatches.class(colour)
            ]}
            aria-hidden="true"
          >
            <Iconify.iconify :if={topic.icon} icon={topic.icon} class="size-8 topic-ink" />
          </div>
        {#match _}
      {/case}
    {#match url}
      <div
        data-id="event_cover"
        role="img"
        aria-label={Bonfire.Files.Media.media_alt(cover(@primary_image, @object))}
        class="size-24 shrink-0 rounded-box bg-center bg-no-repeat bg-cover bg-placeholder"
        style={"background-image: url('#{url}')"}
      />
  {/case}
</div>
