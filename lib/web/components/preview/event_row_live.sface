{!-- the tile's square (badges, title over the cover, and the time or date chip) on the left, half the width; beside it the place and the summary, clamped to the square's height --}
<div
  data-id="event_preview"
  data-layout="list"
  class="flex rounded-box border border-divider bg-base-100 overflow-hidden"
>
  <div class="w-1/2 shrink-0">
    <Bonfire.Gatherings.Web.Preview.EventCoverLive
      object={@object}
      primary_image={cover(@primary_image, @object)}
      cover_class="aspect-square border-b-0"
      placeholder_class="aspect-square border-b-0"
      chip_position_class="top-3 left-3"
      show_date_chip={not @date_in_heading}
      exclude_category_id={@exclude_category_id}
    >
      <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/75 via-black/40 to-transparent px-4 pb-4 pt-12">
        <LinkLive to={@permalink || path(@object)}>
          <h2 class="text-lg font-semibold text-white text-balance leading-snug line-clamp-3 drop-shadow hover:underline">
            {EventLive.name(@object) || l("Untitled event")}
          </h2>
        </LinkLive>
      </div>
    </Bonfire.Gatherings.Web.Preview.EventCoverLive>
  </div>

  {!-- as tall as the square: what does not fit is cut --}
  <div class="relative w-1/2">
    <div class="absolute inset-0 overflow-hidden p-4 flex flex-col">
      <Bonfire.Gatherings.Web.Preview.EventWhenWhereLive
        object={@object}
        time_only={@date_in_heading}
        show_time={not @date_in_heading}
      />

      <p :if={summary_text(@object)} class="mt-3 text-sm text-base-content/80 line-clamp-[8]">{summary_text(@object)}</p>
    </div>
  </div>
</div>
