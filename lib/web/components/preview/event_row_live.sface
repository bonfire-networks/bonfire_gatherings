{!-- the title's link covers the row; the inner links sit above it --}
<div
  data-id="event_preview"
  data-layout="list"
  class="@container isolate relative flex flex-col overflow-hidden rounded-box border border-divider bg-base-100 hover:bg-fill transition-colors"
>
  {!-- narrow: cover on top; from @lg: cover on the right, faded into the text --}
  <div class="flex flex-col p-4 @lg:w-3/5">
    {#case EventLive.starts(@object)}
      {#match nil}
      {#match start}
        {!-- inline, so a long range wraps after "Now ·" --}
        <div data-role="event_when" class="type-meta text-muted tabular-nums">
          {#if happening_now?(@object)}
            <span data-role="event_now" class="font-medium text-error">
              <span
                class="inline-block size-1.5 mr-1 align-middle rounded-full bg-current"
                aria-hidden="true"
              />
              {l("Now")}
            </span>
            <span aria-hidden="true">·</span>
          {/if}
          <time data-role="event_time" datetime={start.iso}>
            {#if @date_in_heading}
              {DatesTimes.format_time_range(start, EventLive.ends(@object)) || l("All day")}
            {#else}
              {DatesTimes.format_range(start, EventLive.ends(@object))}
            {/if}
          </time>
        </div>
    {/case}

    {!-- inset and `!`: overflow clips an outer ring, and the unlayered `a:focus-visible` beats utilities --}
    <LinkLive
      to={@permalink || path(@object)}
      class="mt-1 after:absolute after:inset-0 after:rounded-box focus-visible:outline-none! focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-primary"
    >
      <h2 class="type-heading text-base-content text-balance line-clamp-3 @lg:line-clamp-2">
        {EventLive.name(@object) || l("Untitled event")}
      </h2>
    </LinkLive>

    {#case {EventLive.place(@object), EventLive.online_address(@object), host_name(@object, @activity)}}
      {#match {nil, nil, nil}}
      {#match {place, online, host}}
        <div data-role="event_where" class="mt-1 flex items-center gap-x-1.5 type-meta text-muted">
          {#if place}
            {#case EventLive.place_link(place)}
              {#match nil}
                <span data-role="event_place" class="truncate">{place}</span>
              {#match url}
                <a
                  data-role="event_place"
                  href={url}
                  target="_blank"
                  rel="noopener nofollow"
                  class="relative z-1 truncate hover:underline"
                >{place}</a>
            {/case}
          {/if}
          <span :if={place && online} aria-hidden="true">·</span>
          <a
            :if={online}
            data-role="event_online"
            href={online}
            target="_blank"
            rel="noopener nofollow"
            class="relative z-1 shrink-0 hover:underline"
          >{l("Online")}</a>
          <span :if={host && (place || online)} aria-hidden="true">·</span>
          {!-- the place truncates before the host --}
          <span :if={host} data-role="event_host" class="shrink-0 max-w-1/2 truncate">{l("By %{name}", name: host)}</span>
        </div>
    {/case}

    {#case EventLive.summary(@object)}
      {#match nil}
      {#match ""}
      {#match text}
        {!-- no `_` in these selectors (Tailwind reads it as a space); `!` beats the unlayered `.previewable_truncate` --}
        <div
          data-role="event_summary"
          class="mt-2 [&_[data-truncatable]]:type-meta [&_[data-truncatable]]:text-muted [&_[data-truncatable]]:[-webkit-line-clamp:2]! [&_.read-more-controls]:relative [&_.read-more-controls]:z-1 [&_a]:relative [&_a]:z-1"
        >
          <Bonfire.UI.Common.TruncatableContentLive
            html_body={text}
            parent_id={deterministic_dom_id(__MODULE__, nil, nil, id(@object))}
          />
        </div>
    {/case}

    <div
      :if={badge_names(@object, @exclude_category_id) != []}
      class="flex flex-wrap items-center gap-1.5 mt-3"
    >
      {#for topic <- badge_names(@object, @exclude_category_id)}
        <span data-role="event_badge" class="badge badge-sm gap-1 border-0 bg-fill text-base-content">
          <Iconify.iconify :if={topic.icon} icon={topic.icon} class="size-3" />
          {topic.name}
        </span>
      {/for}
    </div>
  </div>

  {!-- no image: the topic's wash. From @lg it sits behind the text (`-z-1` in `isolate`), masked towards the left --}
  <div class="order-first w-full aspect-[1.91/1] border-b border-divider overflow-hidden @lg:absolute @lg:inset-y-0 @lg:right-0 @lg:-z-1 @lg:w-1/2 @lg:aspect-auto @lg:border-0 @lg:[mask-image:linear-gradient(to_right,transparent,rgb(0_0_0/.05)_15%,rgb(0_0_0/.2)_30%,rgb(0_0_0/.45)_45%,rgb(0_0_0/.7)_60%,rgb(0_0_0/.88)_75%,black_90%)]">
    {#case Bonfire.Common.Media.media_url(cover(@primary_image, @object))}
      {#match nil}
        <EventPlaceholderLive
          object={@object}
          exclude_category_id={@exclude_category_id}
          class="size-full"
          icon_class="size-10"
        />
      {#match url}
        <div
          data-id="event_cover"
          role="img"
          aria-label={Bonfire.Files.Media.media_alt(cover(@primary_image, @object))}
          class="size-full bg-center bg-no-repeat bg-cover bg-placeholder"
          style={"background-image: url('#{url}')"}
        />
    {/case}
  </div>
</div>
