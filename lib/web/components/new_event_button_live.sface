  :if={current_user_id(@__context__) && local_creation?()}
  id="events_header_new"
  component={Bonfire.Gatherings.Web.CreateEventLive}
  prompt={l("New event")}
  icon="ph:plus"
  icon_class="size-4"
  class="btn btn-sm btn-outline border-divider shrink-0 gap-1.5"
  smart_input_opts={%{create_object_type: :event}}
/>
