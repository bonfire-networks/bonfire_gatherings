<section class="bonfire-wrapper page-panel flex flex-col gap-4 p-4">
  {!-- all known events, or (signed in) those of the people I follow and my own; each keeps the time (upcoming or past) and the category or label being viewed --}
  <div class="-mx-4 px-4 border-b border-divider">
    <div role="tablist" data-role="events_tabs" class="tabs tabs-border">
      <LinkLive
        to={filter_path(@category_ref, @label_ref, @time, false, map_view?(@live_action))}
        replace
        class={"tab", "tab-active": not @my}
        opts={role: "tab", "aria-selected": to_string(not @my)}
      >{l("Discover")}</LinkLive>
      <LinkLive
        :if={current_user_id(@__context__)}
        to={filter_path(@category_ref, @label_ref, @time, true, map_view?(@live_action))}
        replace
        class={"tab", "tab-active": @my}
        opts={role: "tab", "aria-selected": to_string(@my)}
      >{l("My events")}</LinkLive>
    </div>
  </div>

  <div class="flex items-end justify-between gap-2 -mx-4 px-4 border-b border-divider">
    <div role="tablist" data-role="events_time_tabs" class="tabs tabs-border">
      <LinkLive
        to={@base_path}
        replace
        class={"tab", "tab-active": @time == :upcoming}
        opts={role: "tab", "aria-selected": to_string(@time == :upcoming)}
      >{l("Upcoming")}</LinkLive>
      {!-- not on the map, which shows the upcoming events (the past ones through the Happening filter) --}
      <LinkLive
        :if={not map_view?(@live_action)}
        to={@base_path <> "/past"}
        replace
        class={"tab", "tab-active": @time == :past}
        opts={role: "tab", "aria-selected": to_string(@time == :past)}
      >{l("Past")}</LinkLive>
    </div>

    <div class="flex items-center gap-1 pb-1">
      {!-- the filters (the customize-feed widget) are in the sidebar, as on the feeds; the tile and map views have no sidebar, so this opens them here --}
      <button
        :if={inline_filters?(@live_action, @event_preview)}
        type="button"
        data-role="toggle_filters"
        phx-click="toggle_filters"
        aria-expanded={to_string(@filters_open)}
        class="btn btn-sm btn-ghost"
      >
        <#Icon iconify="ph:sliders-horizontal" class="size-4" />
        {l("Filters")}
      </button>
      {!-- list, tiles, or the map (a page of its own, filtered as the list is, not saved), in the dropdown the group directory uses for its filters (`GroupFilterMenusLive`) --}
      <form data-id="events_layout" phx-change="set_layout">
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Groups.GroupFilterMenusLive, @__context__)}
          menus={layout_menus(@event_preview, @live_action, @maps_enabled && !!current_user_id(@__context__))}
          form={layout_form(@event_preview, @live_action)}
        />
      </form>
    </div>
  </div>

  <div
    :if={@filters_open and inline_filters?(@live_action, @event_preview)}
    data-role="events_filters"
    class="border-hair border-divider rounded-box bg-base-100 px-4 py-2"
  >
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Social.WidgetCustomizeFeedLive, @__context__)}
      {...customize_props(@time, @my, @filters, map_view?(@live_action))}
    />
  </div>

  {!-- TODO: search, placeholder until the search design is decided
  <div data-id="events_search" role="search">
    <label class="input border-hair border-divider bg-base-100 flex items-center gap-2 w-full">
      <span class="sr-only">{l("Search events")}</span>
      <#Icon iconify="ph:magnifying-glass" class="size-5 shrink-0 text-muted" />
      <input
        type="search"
        name="search"
        placeholder={l("Search events")}
        autocomplete="off"
        class="grow"
      />
    </label>
  </div>
  --}
  {!-- the search index's matches within the upcoming list (`Events.search/2`); no box on the past list or the map, nor without an index --}
  <form
    :if={@search_available and @time == :upcoming and not map_view?(@live_action)}
    data-id="events_search"
    role="search"
    phx-change="search"
    phx-submit="search"
  >
    <label
      for="events_search_input"
      class="input border-hair border-divider bg-base-100 flex items-center gap-2 w-full"
    >
      <span class="sr-only">{l("Search events")}</span>
      <#Icon iconify="ph:magnifying-glass" class="size-5 shrink-0 text-muted" />
      <input
        id="events_search_input"
        type="search"
        name="search"
        value={@search}
        placeholder={l("Search events")}
        autocomplete="off"
        phx-debounce="300"
        class="grow"
      />
    </label>
  </form>

  {!-- the categories of the listed events (facets, as a search shows only the filters found in its results): each links to its page, which lists the events tagged with it. None on the past list for now --}
  <div
    :if={@category_chips.ok? and topic_chips(@category_chips.result) != []}
    data-id="events_categories"
    class="flex items-center gap-2 overflow-x-auto"
    role="group"
    aria-label={l("Filter events by category")}
  >
    {!-- to the same list (upcoming or past) of each category --}
    <LinkLive
      to={filter_path(nil, @label_ref, @time, @my, map_view?(@live_action))}
      class={
        "shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm font-medium transition-colors",
        "border-divider bg-primary/10 text-base-content": is_nil(@selected_category_id),
        "border-divider bg-base-200/40 text-muted hover:bg-base-200 hover:text-base-content":
          not is_nil(@selected_category_id)
      }
    >{l("All")}</LinkLive>

    {!-- {#for category <- @categories}
      <LinkLive
        to={"/events/category/#{category_username(category)}"}
        class={
          "shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm font-medium transition-colors",
          "border-divider bg-primary/10 text-base-content": @selected_category == category,
          "border-divider bg-base-200/40 text-muted hover:bg-base-200 hover:text-base-content":
            @selected_category != category
        }
      >
        <Bonfire.Gatherings.Web.EventCategoryIconLive category={category} class="size-4" colored={false} />
        {Bonfire.Gatherings.EventCategories.label(category)}
      </LinkLive>
    {/for} --}

    {!-- {#for category <- topic_chips(@category_chips.result)} --}
    {!-- the top-level ones; one with subtopics among the chips is a dropdown listing itself and them --}
    {#for {category, subtopics} <- nested_topic_chips(@category_chips.result)}
      {#if subtopics != []}
        <details data-role="chip_dropdown" class="dropdown shrink-0">
          <summary class={
            chip_swatch_class(category),
            "list-none cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm font-medium transition-colors",
            "border-divider bg-primary/10 text-base-content":
              @selected_category_id in [id(category) | Enums.ids(subtopics)],
            "border-divider topic-wash text-muted hover:bg-base-200 hover:text-base-content":
              @selected_category_id not in [id(category) | Enums.ids(subtopics)]
          }>
            {!-- the topic's own icon, in its swatch's colour (was the icon of its FEP-8a8e key, from a branch per key in the icon component, now each topic's own setting):
            {#case category_of_username(e(category, :character, :username, nil))}
              {#match nil}
              {#match key}
                <Bonfire.Gatherings.Web.EventCategoryIconLive category={key} class="size-4" colored={false} />
            {/case} --}
            <Bonfire.Gatherings.Web.EventCategoryIconLive
              icon={chip_icon(category)}
              colour={chip_colour(category)}
              class="size-4"
            />
            {e(category, :profile, :name, nil) || e(category, :character, :username, nil)}
            <#Icon iconify="ph:caret-down-bold" class="size-3" />
          </summary>
          <ul class="dropdown-content menu bg-base-100 rounded-box z-10 w-52 p-2 shadow">
            {#for item <- [category | subtopics]}
              <li>
                <LinkLive to={filter_path(chip_ref(item), @label_ref, @time, @my, map_view?(@live_action))}>
                  {e(item, :profile, :name, nil) || e(item, :character, :username, nil)}
                </LinkLive>
              </li>
            {/for}
          </ul>
        </details>
      {#else}
        <LinkLive
          to={filter_path(chip_ref(category), @label_ref, @time, @my, map_view?(@live_action))}
          class={
            chip_swatch_class(category),
            "shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm font-medium transition-colors",
            "border-divider bg-primary/10 text-base-content": @selected_category_id == id(category),
            "border-divider topic-wash text-muted hover:bg-base-200 hover:text-base-content":
              @selected_category_id != id(category)
          }
        >
          {!-- the topic's own icon (the topics of the FEP-8a8e categories are made with theirs), in its swatch's colour (was the icon of its FEP-8a8e key, from a branch per key in the icon component, now each topic's own setting):
          {#case category_of_username(e(category, :character, :username, nil))}
            {#match nil}
            {#match key}
              <Bonfire.Gatherings.Web.EventCategoryIconLive category={key} class="size-4" colored={false} />
          {/case} --}
          <Bonfire.Gatherings.Web.EventCategoryIconLive
            icon={chip_icon(category)}
            colour={chip_colour(category)}
            class="size-4"
          />
          {e(category, :profile, :name, nil) || e(category, :character, :username, nil)}
        </LinkLive>
      {/if}
    {/for}
  </div>

  {!-- the labels of the listed events (what they are about, eg. "family friendly"), apart from the categories (what kind of event): each links to its page, as a category does --}
  <div
    :if={@category_chips.ok? and label_chips(@category_chips.result) != []}
    data-id="events_labels"
    class="flex flex-wrap items-center gap-1.5"
    role="group"
    aria-label={l("Filter events by label")}
  >
    {#for label <- label_chips(@category_chips.result)}
      <LinkLive
        to={filter_path(@category_ref, chip_ref(label), @time, @my, map_view?(@live_action))}
        class={
          "badge badge-sm gap-1 transition-colors",
          "badge-primary": @selected_label_id == id(label),
          "badge-ghost hover:badge-outline": @selected_label_id != id(label)
        }
      >
        {!-- the label's own icon, else the tag --}
        {#case chip_icon(label)}
          {#match nil}
            <#Icon iconify="ph:tag-fill" class="size-3" />
          {#match icon}
            <Iconify.iconify icon={icon} class="size-3" />
        {/case}
        {e(label, :profile, :name, nil) || e(label, :character, :username, nil)}
      </LinkLive>
    {/for}
  </div>

  {!-- the map page: the listed events' places, each popup with its name, place and link --}
  {!-- (where maps are not set up, `MapLive` says so) --}
  {#if map_view?(@live_action)}
    <div data-id="events_map" class="h-[70vh] rounded-box overflow-hidden border border-divider">
      <StatefulComponent
        module={maybe_component(Bonfire.Geolocate.MapLive, @__context__)}
        id="events_map_component"
        markers={map_markers(@events, @selected_category_id)}
        show_activity={false}
        fallback_places={false}
        bounds_to_parent
        fit_bounds={@map_fit}
        class="h-full"
      />
    </div>
  {#elseif @events == []}
    <div data-id="events_empty" class="text-center text-muted py-8">
      <p class="font-medium text-base-content">
        {if @time == :past, do: l("No past events"), else: l("No upcoming events")}
      </p>
      <p class="text-sm mt-1">{l("Events from people you follow and federated platforms like Mobilizon will appear here.")}</p>
    </div>
  {#else}
    {!-- a heading per day (sticky, so the day stays in sight while scrolling through it), the cards under it showing only their times --}
    {#for {day, day_events} <- by_day(@events, sorted_by_start?(@time, @filters))}
      <section
        data-role="events_day_group"
        class={"relative flex flex-col gap-3", "pl-6": day && not tiles?(@event_preview)}
      >
        <span
          :if={day && not tiles?(@event_preview)}
          aria-hidden="true"
          class="absolute left-1 top-8 -bottom-4 border-l border-dashed border-divider"
        />
        <h3
          :if={day}
          data-role="events_day"
          class={
            "sticky top-0 z-10 py-2 bg-base-100/95 backdrop-blur text-sm font-bold text-base-content flex items-baseline gap-2",
            "-mx-4 px-4 border-b border-divider": tiles?(@event_preview)
          }
        >
          <span
            :if={not tiles?(@event_preview)}
            aria-hidden="true"
            class="absolute -left-6 top-1/2 -translate-y-1/2 size-2 rounded-full bg-fill-strong"
          />
          {#case day_word(List.first(day_events))}
            {#match nil}
              {day}
            {#match word}
              <span data-role="events_day_word">{word}</span>
              <span class="font-normal text-muted">{day}</span>
          {/case}
        </h3>
        {#if tiles?(@event_preview)}
          {!-- as tiles in a grid (`EventTileLive`, which a feed can use too, as its `custom_preview`), two per row from large phones (400px wide), three from tablets (`md`, where the left sidebar is a drawer, so the tiles have the whole width) --}
          <div data-id="events_grid" class="grid grid-cols-1 min-[350px]:grid-cols-2 md:grid-cols-3 gap-4">
            {#for event <- day_events}
              <StatelessComponent
                module={@event_preview}
                object={event}
                date_in_heading
                exclude_category_id={@selected_category_id}
              />
            {/for}
          </div>
        {#else}
          {#for event <- day_events}
            {!-- <EventLive object={event} parent_id={"events_page_#{id(event)}"} showing_within={:events} /> --}
            {!-- its image as the cover, as in feeds (`Bonfire.UI.Social.ActivityLive`), and no list of its other media --}
            {#case EventLive.split_media(e(event, :files, nil))}
              {#match {primary_image, _media}}
                {!-- <EventLive
              object={event}
              primary_image={primary_image}
              parent_id={"events_page_#{id(event)}"}
              showing_within={:events}
              date_in_heading
              exclude_category_id={@selected_category_id}
            /> --}
                {!-- a row: a square cover, its text beside it --}
                <StatelessComponent
                  module={@event_preview}
                  object={event}
                  primary_image={primary_image}
                  date_in_heading
                  exclude_category_id={@selected_category_id}
                />
                {!-- <StatelessComponent
                  :if={media != []}
                  module={maybe_component(Bonfire.UI.Social.Activity.MediaLive, @__context__)}
                  media={media}
                  parent_id={"events_page_media_#{id(event)}"}
                  showing_within={:events}
                /> --}
            {/case}
          {/for}
        {/if}
      </section>
    {/for}

    {#if e(@page_info, :end_cursor, nil)}
      <button type="button" phx-click="load_more" class="btn btn-ghost btn-sm self-center">
        {l("Load more")}
      </button>
    {/if}
  {/if}
</section>
